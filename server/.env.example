# Environment variables for the server

# app name
APP_NAME="DevEval"

# environment
NODE_ENV="Environment mode (development/production)"
PORT="Port number for the server(e.g., 5000)"

# database
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# bcryptjs
BCRYPTJS_SALT_ROUND="Bcrypt salt round value"

# frontend url
FRONTEND_DEV_URL="Frontend development URL"
FRONTEND_PROD_URL="Frontend production URL"

# backend url
BACKEND_DEV_URL="Backend development URL"
BACKEND_PROD_URL="Backend production URL"

# Auth Tokens
ACCESS_TOKEN_SECRET="Secret key for access token"
ACCESS_TOKEN_EXPIRES_IN="Access token expiration time (e.g., 15m, 1h)"
REFRESH_TOKEN_SECRET="Secret key for refresh token"
REFRESH_TOKEN_EXPIRES_IN="Refresh token expiration time (e.g., 30d)"

# admin
ADMIN_FIRST_NAME="First name of the admin"
ADMIN_LAST_NAME="Last name of the admin"
ADMIN_EMAIL="Email of the admin"
ADMIN_PASS="Password of the admin"


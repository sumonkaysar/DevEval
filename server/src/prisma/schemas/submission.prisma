// use prisma-8

enum Status {
  PENDING
  APPROVED
  REJECTED
}

model Submission {
  id          String    @id @default(uuid())
  projectName String
  repoUrl     String    @unique
  liveLink    String?
  description String
  status      Status    @default(PENDING)

  studentId   String
  student     User      @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  mentorId    String?   
  mentor      User?     @relation("MentorReviews", fields: [mentorId], references: [id], onDelete: SetNull)

  feedback    Feedback?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("submissions")
}